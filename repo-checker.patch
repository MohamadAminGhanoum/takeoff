+import { pickSamples } from "./rules";
+import type { CommitInfo, Snapshot, TreeEntry } from "./types";
+
+export class CheckError extends Error {
+  constructor(
+    public code: "bad_url" | "not_found" | "rate_limit" | "github",
+    message: string
+  ) {
+    super(message);
+  }
+}
+
+const API = "https://api.github.com";
+const NAME = /^[A-Za-z0-9_.-]{1,100}$/;
+
+/** Accepts github.com URLs only. Returns null for anything else. */
+export function parseRepoUrl(input: string): { owner: string; repo: string } | null {
+  let u: URL;
+  try {
+    u = new URL(input.trim());
+  } catch {
+    return null;
+  }
+  if (u.protocol !== "https:" || !["github.com", "www.github.com"].includes(u.hostname)) {
+    return null;
+  }
+  const [owner, rawRepo] = u.pathname.split("/").filter(Boolean);
+  if (!owner || !rawRepo) return null;
+  const repo = rawRepo.replace(/\.git$/i, "");
+  if (!NAME.test(owner) || !NAME.test(repo)) return null;
+  return { owner, repo };
+}
+
+function headers(accept = "application/vnd.github+json"): HeadersInit {
+  const h: Record<string, string> = {
+    Accept: accept,
+    "User-Agent": "takeoff-repo-checker",
+    "X-GitHub-Api-Version": "2022-11-28",
+  };
+  if (process.env.GITHUB_TOKEN) h.Authorization = `Bearer ${process.env.GITHUB_TOKEN}`;
+  return h;
+}
+
+async function gh(path: string, accept?: string): Promise<Response> {
+  const res = await fetch(`${API}${path}`, {
+    headers: headers(accept),
+    cache: "no-store",
+    signal: AbortSignal.timeout(15_000),
+  });
+  if (res.status === 403 || res.status === 429) {
+    const left = res.headers.get("x-ratelimit-remaining");
+    if (left === "0" || res.status === 429) {
+      throw new CheckError(
+        "rate_limit",
+        process.env.GITHUB_TOKEN
+          ? "GitHub rate limit reached. Try again in a few minutes."
+          : "GitHub rate limit reached. Add a GITHUB_TOKEN to .env.local to raise the limit."
+      );
+    }
+  }
+  return res;
+}
+
+async function ghJson<T>(path: string): Promise<T | null> {
+  const res = await gh(path);
+  if (res.status === 404 || res.status === 409 || res.status === 204) return null;
+  if (!res.ok) throw new CheckError("github", `GitHub returned ${res.status} for ${path}.`);
+  return (await res.json()) as T;
+}
+
+type RawCommit = {
+  sha: string;
+  commit: { message: string; author?: { date?: string; name?: string } };
+  author?: { login?: string } | null;
+};
+
+const toCommit = (c: RawCommit): CommitInfo => ({
+  sha: c.sha,
+  date: c.commit.author?.date ?? "",
+  message: c.commit.message ?? "",
+  author: c.author?.login ?? c.commit.author?.name,
+});
+
+export async function getSnapshot(owner: string, repo: string): Promise<Snapshot> {
+  const info = await ghJson<{
+    full_name: string;
+    html_url: string;
+    description: string | null;
+    topics?: string[];
+    default_branch: string;
+    fork: boolean;
+    parent?: { full_name: string };
+    archived: boolean;
+    private?: boolean;
+    created_at: string;
+    pushed_at: string;
+    license: { spdx_id: string | null } | null;
+  }>(`/repos/${owner}/${repo}`);
+  if (!info) {
+    throw new CheckError("not_found", "Repo not found, or it is private. Reviewers can only check public repos.");
+  }
+
+  const base = `/repos/${owner}/${repo}`;
+
+  const [treeRaw, commitsRes, readme, contributors] = await Promise.all([
+    ghJson<{ tree: { path: string; type: string; size?: number }[]; truncated: boolean }>(
+      `${base}/git/trees/${encodeURIComponent(info.default_branch)}?recursive=1`
+    ).catch(rethrowRateLimit),
+    gh(`${base}/commits?per_page=100`).catch(rethrowRateLimit),
+    gh(`${base}/readme`, "application/vnd.github.raw+json")
+      .then((r) => (r.ok ? r.text() : null))
+      .catch(rethrowRateLimit),
+    ghJson<{ login: string; contributions: number }[]>(`${base}/contributors?per_page=10`).catch(rethrowRateLimit),
+  ]);
+
+  const tree: TreeEntry[] = (treeRaw?.tree ?? [])
+    .filter((t) => t.type === "blob")
+    .map((t) => ({ path: t.path, size: t.size ?? 0 }));
+
+  // Commits: newest 100, the total count, and the very first commit.
+  let recentCommits: CommitInfo[] = [];
+  let commitCount = 0;
+  let firstCommit: Snapshot["firstCommit"] = null;
+
+  if (commitsRes && commitsRes.ok) {
+    const list = (await commitsRes.json()) as RawCommit[];
+    recentCommits = list.map(toCommit);
+    commitCount = list.length;
+
+    if (list.length === 100) {
+      // Count by asking for one commit per page and reading the last page number.
+      const probe = await gh(`${base}/commits?per_page=1`).catch(rethrowRateLimit);
+      const link = probe?.headers.get("link") ?? "";
+      const last = /[?&]page=(\d+)>;\s*rel="last"/.exec(link);
+      if (last) commitCount = Number(last[1]);
+    }
+
+    let firstRaw: RawCommit | undefined = list.at(-1);
+    if (commitCount > list.length) {
+      const page = await ghJson<RawCommit[]>(`${base}/commits?per_page=1&page=${commitCount}`).catch(rethrowRateLimit);
+      if (page?.[0]) firstRaw = page[0];
+    }
+    if (firstRaw) {
+      const detail = await ghJson<{ files?: unknown[] }>(`${base}/commits/${firstRaw.sha}`).catch(() => null);
+      firstCommit = { ...toCommit(firstRaw), filesChanged: detail?.files ? detail.files.length : null };
+    }
+  }
+
+  // Look inside a few hardware files so rules can tell empty designs from real ones.
+  const fileText: Record<string, string> = {};
+  await Promise.all(
+    pickSamples(tree).map(async (path) => {
+      try {
+        const url = `https://raw.githubusercontent.com/${owner}/${repo}/${encodeURIComponent(info.default_branch)}/${path
+          .split("/")
+          .map(encodeURIComponent)
+          .join("/")}`;
+        const r = await fetch(url, {
+          headers: { "User-Agent": "takeoff-repo-checker" },
+          cache: "no-store",
+          signal: AbortSignal.timeout(15_000),
+        });
+        if (r.ok) fileText[path] = (await r.text()).slice(0, 3_000_000);
+      } catch {
+        // A file that can't be read just means that rule is skipped.
+      }
+    })
+  );
+
+  return {
+    owner,
+    repo,
+    fullName: info.full_name,
+    htmlUrl: info.html_url,
+    description: info.description,
+    topics: info.topics ?? [],
+    defaultBranch: info.default_branch,
+    isFork: info.fork,
+    parentFullName: info.parent?.full_name ?? null,
+    archived: info.archived,
+    createdAt: info.created_at,
+    pushedAt: info.pushed_at,
+    license: info.license?.spdx_id ?? null,
+    tree,
+    treeTruncated: !!treeRaw?.truncated,
+    commitCount,
+    recentCommits,
+    firstCommit,
+    contributors: contributors ?? [],
+    readme: readme ?? null,
+    fileText,
+  };
+}
+
+// Non-essential calls may fail quietly, but a rate limit must reach the reviewer.
+function rethrowRateLimit(e: unknown): null {
+  if (e instanceof CheckError && e.code === "rate_limit") throw e;
+  return null;
+}
diff --git a/lib/checker/rules.ts b/lib/checker/rules.ts
new file mode 100644
index 0000000..aad04bd
--- /dev/null
+++ b/lib/checker/rules.ts
@@ -0,0 +1,524 @@
+// Pure rule engine. No network, no framework imports, so it can be tested alone.
+import type {
+  Context,
+  Evaluation,
+  Finding,
+  Group,
+  Kind,
+  Level,
+  Snapshot,
+  Stats,
+  TreeEntry,
+  Verdict,
+} from "./types";
+
+/* ------------------------------------------------------------------ */
+/* File classification                                                 */
+/* ------------------------------------------------------------------ */
+
+const SET = (s: string) => new Set(s.split(" "));
+
+const SCHEMATIC = SET("kicad_sch sch schdoc");
+const PCB = SET("kicad_pcb brd pcbdoc");
+const GERBER = SET(
+  "gbr gtl gbl gts gbs gto gbo gtp gbp gko gm1 gml drl xln gerber"
+);
+// Editable CAD sources vs. neutral/export formats.
+const CAD_SOURCE = SET(
+  "f3d f3z sldprt sldasm ipt iam fcstd scad blend skp par psm 3dm dwg dxf"
+);
+const CAD_EXPORT = SET("step stp iges igs stl 3mf obj x_t");
+const IMAGE = SET("png jpg jpeg gif webp heic");
+const VIDEO = SET("mp4 mov webm mkv");
+const CODE = SET(
+  "ino pde c cc cpp cxx h hpp s rs py js jsx ts tsx go java kt swift cs rb php html css vue svelte dart lua zig nim"
+);
+const FIRMWARE_HINT_EXT = SET("ino ioc uf2 hex elf");
+const FIRMWARE_HINT_NAME = SET(
+  "platformio.ini sdkconfig sdkconfig.defaults boards.txt memory.x"
+);
+const MANIFESTS = SET(
+  "package.json requirements.txt pyproject.toml cargo.toml go.mod pom.xml build.gradle"
+);
+
+const base = (p: string) => p.slice(p.lastIndexOf("/") + 1).toLowerCase();
+const ext = (p: string) => {
+  const b = base(p);
+  const i = b.lastIndexOf(".");
+  return i === -1 ? "" : b.slice(i + 1);
+};
+const depth = (p: string) => p.split("/").length;
+
+// Build output / environments that should never be in a repo.
+const JUNK =
+  /(^|\/)(node_modules|\.pio|venv|\.venv|__pycache__|\.next|\.gradle|site-packages)\//i;
+// Third-party code that is legitimate in small amounts (Arduino libraries etc.).
+const VENDORED =
+  /(^|\/)(vendor|third_party|thirdparty|libraries|external|extern|deps|components\/[^/]+\/vendor)\//i;
+const SECRET_FILE = /(^|\/)(\.env(\..+)?|id_rsa|id_ed25519|.*\.pem|.*\.p12)$/i;
+const BOM_NAME = /(bom|bill[-_ ]?of[-_ ]?materials)/i;
+const BOM_EXT = SET("csv tsv xlsx xls md txt json html ods");
+
+const HARDWARE_WORDS =
+  /\b(pcb|circuit|hardware|esp32|esp8266|rp2040|rp2350|arduino|stm32|attiny|sensor|servo|motor|schematic|kicad|easyeda|3d[- ]?print|fusion ?360|soldering|breadboard|flight controller|esc|lipo|battery|gyro|imu|gps|lora|antenna|transmitter|receiver|microcontroller)\b/i;
+
+const AVIATION_WORDS = [
+  "aircraft",
+  "airplane",
+  "aeroplane",
+  "plane",
+  "drone",
+  "quadcopter",
+  "multirotor",
+  "fixed-wing",
+  "fixed wing",
+  "uav",
+  "flight",
+  "flying",
+  "aviation",
+  "avionics",
+  "glider",
+  "helicopter",
+  "airport",
+  "airspeed",
+  "pitot",
+  "altimeter",
+  "autopilot",
+  "ads-b",
+  "adsb",
+  "cockpit",
+  "pilot",
+  "runway",
+  "atc",
+  "air traffic",
+  "wing",
+  "propeller",
+  "rc plane",
+  "rocket",
+  "telemetry",
+  "metar",
+  "airfoil",
+];
+
+const README_TEMPLATES: { re: RegExp; label: string }[] = [
+  { re: /bootstrapped with .{0,40}create-next-app/i, label: "create-next-app default" },
+  { re: /getting started with create react app/i, label: "Create React App default" },
+  { re: /this template should help get you started/i, label: "Vite template default" },
+  { re: /lorem ipsum/i, label: "placeholder text" },
+  { re: /your project (title|name) here|project title goes here|add your description here/i, label: "unfilled template" },
+  { re: /^\s*#\s*(project title|my project|untitled)\s*$/im, label: "unfilled title" },
+];
+
+/* ------------------------------------------------------------------ */
+/* Content analysis for sampled hardware files                         */
+/* ------------------------------------------------------------------ */
+
+export function analyzePcb(text: string) {
+  const footprints =
+    (text.match(/\(footprint\s/g)?.length ?? 0) +
+    (text.match(/\(module\s/g)?.length ?? 0);
+  const tracks =
+    (text.match(/\(segment\s/g)?.length ?? 0) +
+    (text.match(/\(arc\s/g)?.length ?? 0);
+  const vias = text.match(/\(via\s/g)?.length ?? 0;
+  const outline = (text.match(/Edge\.Cuts/g)?.length ?? 0) >= 2;
+  return { footprints, tracks, vias, outline };
+}
+
+export function analyzeSchematic(text: string) {
+  let components = 0;
+  for (const m of text.matchAll(/\(lib_id\s+"([^"]+)"/g)) {
+    if (!m[1].startsWith("power:")) components++;
+  }
+  // KiCad 5 and older.
+  components += (text.match(/^\$Comp$/gm)?.length ?? 0);
+  const wires =
+    (text.match(/\(wire\s/g)?.length ?? 0) +
+    (text.match(/^Wire Wire Line/gm)?.length ?? 0);
+  return { components, wires };
+}
+
+export function bomRows(text: string) {
+  const lines = text.split(/\r?\n/).filter((l) => l.trim().length > 0);
+  return Math.max(0, lines.length - 1);
+}
+
+/** Which files the fetcher should download so the rules can look inside. */
+export function pickSamples(tree: TreeEntry[]): string[] {
+  const byDepth = (a: TreeEntry, b: TreeEntry) => depth(a.path) - depth(b.path);
+  const ok = (e: TreeEntry, max: number) =>
+    e.size > 0 && e.size <= max && !JUNK.test(e.path);
+  const pcb = tree
+    .filter((e) => ext(e.path) === "kicad_pcb" && ok(e, 3_000_000))
+    .sort(byDepth)
+    .slice(0, 2);
+  const sch = tree
+    .filter((e) => ext(e.path) === "kicad_sch" && ok(e, 3_000_000))
+    .sort(byDepth)
+    .slice(0, 2);
+  const bom = tree
+    .filter(
+      (e) =>
+        BOM_NAME.test(base(e.path)) &&
+        ["csv", "tsv"].includes(ext(e.path)) &&
+        ok(e, 300_000)
+    )
+    .sort(byDepth)
+    .slice(0, 1);
+  return [...pcb, ...sch, ...bom].map((e) => e.path);
+}
+
+/* ------------------------------------------------------------------ */
+/* Evaluation                                                          */
+/* ------------------------------------------------------------------ */
+
+const dayKey = (iso: string) => iso.slice(0, 10);
+const daysBetween = (a: string, b: string) =>
+  Math.max(0, (Date.parse(b) - Date.parse(a)) / 86_400_000);
+
+export function evaluate(s: Snapshot, ctx: Context = {}): Evaluation {
+  const findings: Finding[] = [];
+  const add = (
+    group: Group,
+    level: Level,
+    id: string,
+    title: string,
+    detail: string
+  ) => findings.push({ id, group, level, title, detail });
+
+  /* ---- classify the tree ---- */
+  const files = s.tree;
+  const live = files.filter((f) => !JUNK.test(f.path));
+  const own = live.filter((f) => !VENDORED.test(f.path));
+
+  const withExt = (set: Set<string>, list = live) =>
+    list.filter((f) => set.has(ext(f.path)));
+
+  const schematics = withExt(SCHEMATIC);
+  const pcbs = withExt(PCB);
+  const gerbers = [
+    ...withExt(GERBER),
+    ...live.filter(
+      (f) => ext(f.path) === "zip" && /gerber|fab|jlc|pcbway/i.test(f.path)
+    ),
+  ];
+  const boms = live.filter(
+    (f) => BOM_NAME.test(base(f.path)) && BOM_EXT.has(ext(f.path))
+  );
+  const cadSource = withExt(CAD_SOURCE);
+  const cadExport = withExt(CAD_EXPORT);
+  const cad = [...cadSource, ...cadExport];
+  const images = withExt(IMAGE);
+  const videos = withExt(VIDEO);
+  const code = own.filter((f) => CODE.has(ext(f.path)));
+  const sourceBytes = code.reduce((n, f) => n + f.size, 0);
+  const firmwareHint =
+    live.some((f) => FIRMWARE_HINT_EXT.has(ext(f.path))) ||
+    live.some((f) => FIRMWARE_HINT_NAME.has(base(f.path)));
+  const hasManifest = live.some((f) => MANIFESTS.has(base(f.path)));
+
+  const hasHardwareFiles =
+    pcbs.length + schematics.length + cad.length + gerbers.length > 0;
+  const hasSoftware = code.length >= 2 || hasManifest;
+
+  const text = [
+    ctx.description ?? "",
+    s.description ?? "",
+    s.topics.join(" "),
+    s.repo,
+    (s.readme ?? "").slice(0, 2000),
+  ].join("\n");
+  const hardwareClaimed = HARDWARE_WORDS.test(text);
+
+  let kind: Kind = "unclear";
+  if (hasHardwareFiles && (hasSoftware || firmwareHint)) kind = "both";
+  else if (hasHardwareFiles) kind = "hardware";
+  else if (hasSoftware || firmwareHint) kind = hardwareClaimed ? "both" : "software";
+  const isHardware = kind === "hardware" || kind === "both";
+
+  /* ---- history numbers ---- */
+  const newest = s.recentCommits[0]?.date;
+  const oldest = s.firstCommit?.date ?? s.recentCommits.at(-1)?.date;
+  const spanDays = newest && oldest ? daysBetween(oldest, newest) : null;
+  const activeDays = s.recentCommits.length
+    ? new Set(s.recentCommits.map((c) => dayKey(c.date))).size
+    : null;
+
+  /* ================== Repository ================== */
+  if (s.archived) {
+    add("Repository", "info", "archived", "Repo is archived", "The owner archived it; it is read-only now.");
+  }
+
+  if (files.length === 0) {
+    add("Repository", "fail", "empty", "Repo is empty", "There are no files on the default branch.");
+  } else if (own.length < 3) {
+    add("Repository", "fail", "tiny", "Almost nothing here", `Only ${own.length} file${own.length === 1 ? "" : "s"} outside build and library folders.`);
+  } else {
+    add("Repository", "pass", "files", `${own.length} project files`, "Enough files to look at.");
+  }
+
+  if (s.isFork) {
+    add(
+      "Repository",
+      "warn",
+      "fork",
+      "This repo is a fork",
+      `Forked from ${s.parentFullName ?? "another repo"}. Check that the work is the author's own and not the original project.`
+    );
+  }
+
+  const junk = files.filter((f) => JUNK.test(f.path));
+  if (junk.length > 0) {
+    const dirs = [...new Set(junk.map((f) => JUNK.exec(f.path)?.[2] ?? ""))].filter(Boolean);
+    add("Repository", "warn", "junk", "Build or environment folders are committed", `${junk.length} files in ${dirs.join(", ")}. Usually means files were dragged in without a .gitignore.`);
+  }
+
+  const secrets = live.filter((f) => SECRET_FILE.test(f.path));
+  if (secrets.length > 0) {
+    add("Repository", "warn", "secrets", "Possible secrets committed", `Found ${secrets.slice(0, 3).map((f) => f.path).join(", ")}. Ask the author to rotate any keys in them.`);
+  }
+
+  if (s.treeTruncated) {
+    add("Repository", "info", "truncated", "File list was cut off", "GitHub truncated the tree because the repo is very large, so counts below may be low.");
+  }
+
+  /* ================== History ================== */
+  if (s.commitCount === 0) {
+    add("History", "fail", "no-commits", "No commits", "The repo has no history at all.");
+  } else if (s.commitCount === 1) {
+    add("History", "fail", "one-commit", "Everything is in one commit", "The whole project was uploaded at once, so there is no build history to look at. Ask for Hackatime proof or earlier work.");
+  } else if (s.commitCount < 5) {
+    add("History", "warn", "few-commits", `Only ${s.commitCount} commits`, "Very little history for a project that is supposed to take many hours.");
+  } else {
+    add("History", "pass", "commits", `${s.commitCount} commits`, "Reasonable amount of history.");
+  }
+
+  if (s.firstCommit?.filesChanged != null && files.length > 0) {
+    const n = s.firstCommit.filesChanged;
+    if (n >= 25 && n >= files.length * 0.5 && s.commitCount > 1) {
+      add("History", "warn", "bulk-first", "First commit holds most of the project", `The first commit added ${n} files, about ${Math.round((n / files.length) * 100)}% of the repo. Common when work is copied in from somewhere else.`);
+    }
+  }
+
+  const webUploads = s.recentCommits.filter((c) =>
+    /^(add files via upload|upload files|create [\w.\- ]+\.md|update [\w.\- ]+\.md)\s*$/i.test(c.message.split("\n")[0].trim())
+  );
+  if (s.recentCommits.length >= 3 && webUploads.length / s.recentCommits.length >= 0.5) {
+    add("History", "warn", "web-upload", "Most commits are GitHub web uploads", `${webUploads.length} of the last ${s.recentCommits.length} commits were drag-and-drop uploads, not normal commits.`);
+  }
+
+  if (spanDays != null && s.commitCount > 1) {
+    if (spanDays < 1) {
+      add("History", "warn", "same-day", "All commits are within one day", "The entire history fits in less than 24 hours.");
+    }
+    if (ctx.hoursClaimed && ctx.hoursClaimed > 0) {
+      const h = ctx.hoursClaimed;
+      const spanHours = spanDays * 24;
+      if (h >= 10 && spanHours < h) {
+        add("History", "warn", "hours-vs-span", "Claimed hours don't fit the timeline", `${h} hours claimed, but the first and last commits are only ${spanHours.toFixed(1)} hours apart. Offline work is possible, so ask for the Hackatime breakdown.`);
+      } else if (h >= 25 && activeDays != null && activeDays <= 2) {
+        add("History", "warn", "hours-vs-days", "Many hours but commits on very few days", `${h} hours claimed, but the latest ${s.recentCommits.length} commits fall on ${activeDays} day${activeDays === 1 ? "" : "s"}.`);
+      }
+    }
+    if (activeDays != null && activeDays >= 4) {
+      add("History", "pass", "active-days", `Commits on ${activeDays} different days`, `Spread over about ${Math.round(spanDays)} days.`);
+    }
+  }
+
+  if (s.firstCommit && daysBetween(s.firstCommit.date, s.createdAt) > 1) {
+    add("History", "info", "history-predates", "History is older than the repo", `The first commit is dated ${dayKey(s.firstCommit.date)} but the repo was created ${dayKey(s.createdAt)}. The history was pushed in from elsewhere, which is normal for work moved over but worth a glance.`);
+  }
+
+  if (s.contributors.length > 0) {
+    const top = s.contributors[0];
+    if (top.login.toLowerCase() !== s.owner.toLowerCase()) {
+      add("History", "info", "other-author", `Most commits are by ${top.login}`, `The repo belongs to ${s.owner}. Fine for teams, but confirm the submitter did the work.`);
+    }
+  }
+
+  /* ================== Hardware ================== */
+  if (isHardware || hardwareClaimed) {
+    if (hardwareClaimed && !hasHardwareFiles) {
+      add("Hardware", "warn", "no-hw-files", "Hardware project but no design files", "The text talks about hardware, but there are no schematic, PCB or CAD files. Reviewers can't check what was designed.");
+    }
+
+    if (pcbs.length > 0) {
+      add("Hardware", "pass", "pcb", `${pcbs.length} PCB file${pcbs.length === 1 ? "" : "s"}`, pcbs.slice(0, 3).map((f) => f.path).join(", "));
+    }
+    if (schematics.length > 0) {
+      add("Hardware", "pass", "sch", `${schematics.length} schematic file${schematics.length === 1 ? "" : "s"}`, schematics.slice(0, 3).map((f) => f.path).join(", "));
+    }
+    if (schematics.length > 0 && pcbs.length === 0) {
+      add("Hardware", "warn", "sch-no-pcb", "Schematic but no board layout", "A schematic alone is not a PCB design. Check that a layout exists.");
+    }
+    if (pcbs.length > 0 && schematics.length === 0) {
+      add("Hardware", "warn", "pcb-no-sch", "Board layout but no schematic", "Reviewers can't check connections without the schematic.");
+    }
+
+    // Look inside the sampled KiCad files.
+    for (const [path, content] of Object.entries(s.fileText)) {
+      const e = ext(path);
+      if (e === "kicad_pcb") {
+        const a = analyzePcb(content);
+        if (a.footprints === 0) {
+          add("Hardware", "fail", `pcb-empty:${path}`, "PCB file has no parts", `${path} contains no footprints, so it is an empty board.`);
+        } else if (a.tracks + a.vias === 0) {
+          add("Hardware", "warn", `pcb-unrouted:${path}`, "PCB has parts but no traces", `${path} has ${a.footprints} footprints and nothing routed between them.`);
+        } else {
+          add("Hardware", "pass", `pcb-ok:${path}`, `PCB has ${a.footprints} parts and ${a.tracks} traces`, path);
+        }
+        if (a.footprints > 0 && !a.outline) {
+          add("Hardware", "warn", `pcb-outline:${path}`, "PCB has no board outline", `${path} has no Edge.Cuts shape, so it can't be fabricated as is.`);
+        }
+      } else if (e === "kicad_sch") {
+        const a = analyzeSchematic(content);
+        if (a.components === 0 && content.length > 0) {
+          add("Hardware", "warn", `sch-empty:${path}`, "Schematic sheet has no parts", `${path} has no placed components. It may be a blank or hierarchical top sheet.`);
+        } else if (a.components > 0 && a.wires === 0) {
+          add("Hardware", "warn", `sch-nowires:${path}`, "Schematic parts aren't wired", `${path} has ${a.components} parts and no wires.`);
+        }
+      } else if (BOM_NAME.test(base(path))) {
+        const rows = bomRows(content);
+        if (rows < 3) {
+          add("Hardware", "warn", `bom-short:${path}`, "BOM is almost empty", `${path} lists ${rows} part${rows === 1 ? "" : "s"}.`);
+        } else {
+          add("Hardware", "pass", `bom-ok:${path}`, `BOM lists ${rows} lines`, path);
+        }
+      }
+    }
+
+    if (boms.length > 0) {
+      add("Hardware", "pass", "bom", "BOM found", boms.slice(0, 2).map((f) => f.path).join(", "));
+    } else if (pcbs.length > 0 || schematics.length > 0) {
+      add("Hardware", "warn", "no-bom", "No bill of materials", "No BOM file was found. Reviewers need a parts list to judge cost and effort.");
+    }
+
+    if (pcbs.length > 0 && gerbers.length === 0) {
+      add("Hardware", "info", "no-gerbers", "No fabrication files", "No Gerbers or drill files. Fine if the KiCad project is the source of truth.");
+    } else if (gerbers.length > 0) {
+      add("Hardware", "pass", "gerbers", "Fabrication files present", `${gerbers.length} Gerber/drill file${gerbers.length === 1 ? "" : "s"}.`);
+    }
+
+    if (cad.length > 0) {
+      if (cadSource.length === 0) {
+        add("Hardware", "info", "cad-export-only", "CAD has exports only", "Only STL/STEP style files. The editable source (Fusion, SolidWorks, FreeCAD, OpenSCAD) would let reviewers verify the design.");
+      } else {
+        add("Hardware", "pass", "cad", `${cad.length} CAD file${cad.length === 1 ? "" : "s"}`, `${cadSource.length} editable source file${cadSource.length === 1 ? "" : "s"}.`);
+      }
+      const tiny = cad.filter((f) => f.size > 0 && f.size < 1500);
+      if (tiny.length > 0) {
+        add("Hardware", "warn", "cad-tiny", "CAD files are suspiciously small", `${tiny.slice(0, 3).map((f) => f.path).join(", ")} ${tiny.length === 1 ? "is" : "are"} under 1.5 KB, which is too small for a real model.`);
+      }
+    }
+
+    if (isHardware && !firmwareHint && code.length === 0 && pcbs.length > 0) {
+      add("Hardware", "info", "no-firmware", "No firmware found", "There is a board but no code for it. Fine for a passive or purely mechanical project.");
+    }
+
+    const photoCount = images.length + videos.length;
+    const readmeImgs = countReadmeImages(s.readme);
+    if (photoCount + readmeImgs === 0) {
+      add("Hardware", "warn", "no-photos", "No photos or video of the build", "Nothing shows the real hardware. For a hardware ship, reviewers expect at least one photo.");
+    } else {
+      add("Hardware", "pass", "photos", "Photos or video included", `${images.length} image file${images.length === 1 ? "" : "s"}, ${videos.length} video, ${readmeImgs} in the README.`);
+    }
+  }
+
+  /* ================== Software ================== */
+  if (kind === "software" || kind === "both" || kind === "unclear") {
+    if (kind === "unclear" && files.length > 0 && own.length >= 3) {
+      add("Software", "fail", "unrecognised", "No recognisable project files", "No hardware design files and no source code were found. It may be only documents or images.");
+    }
+    if (code.length > 0 && sourceBytes < 2000 && !hasHardwareFiles) {
+      add("Software", "warn", "little-code", "Very little code", `${code.length} source file${code.length === 1 ? "" : "s"} totalling ${(sourceBytes / 1024).toFixed(1)} KB.`);
+    } else if (code.length > 0) {
+      add("Software", "pass", "code", `${code.length} source files`, `${(sourceBytes / 1024).toFixed(0)} KB of code outside library folders.`);
+    }
+  }
+
+  /* ================== Docs ================== */
+  const readme = s.readme?.trim() ?? "";
+  if (!readme) {
+    add("Docs", "fail", "no-readme", "No README", "There's nothing explaining what the project is or how it works.");
+  } else {
+    if (readme.length < 200) {
+      add("Docs", "fail", "readme-short", "README is almost empty", `Only ${readme.length} characters.`);
+    } else if (readme.length < 600) {
+      add("Docs", "warn", "readme-thin", "README is thin", `${readme.length} characters. Reviewers usually need more than a paragraph.`);
+    } else {
+      add("Docs", "pass", "readme", "README has real content", `${readme.length} characters.`);
+    }
+
+    const tpl = README_TEMPLATES.find((t) => t.re.test(readme));
+    if (tpl) {
+      add("Docs", "warn", "readme-template", "README is still a template", `Looks like the ${tpl.label}.`);
+    }
+
+    if (isHardware) {
+      const words = ["bom", "bill of materials", "wiring", "pinout", "schematic", "assembly", "build", "parts", "components", "firmware", "flash"];
+      const lower = readme.toLowerCase();
+      const hits = words.filter((w) => lower.includes(w));
+      if (hits.length < 2) {
+        add("Docs", "warn", "readme-hw", "README doesn't cover the build", "For hardware it should mention parts, wiring or assembly, and how to flash or use it.");
+      } else {
+        add("Docs", "pass", "readme-hw", "README covers the build", `Mentions ${hits.slice(0, 4).join(", ")}.`);
+      }
+    }
+  }
+
+  const aviation = AVIATION_WORDS.filter((w) =>
+    new RegExp(`\\b${w.replace(/[-\s]/g, "[-\\s]?")}`, "i").test(text + (s.readme ?? ""))
+  );
+  if (aviation.length === 0) {
+    add("Docs", "warn", "theme", "No aviation connection found", "None of the README, description or topics mention anything aviation-related. Confirm the project fits the theme.");
+  } else {
+    add("Docs", "pass", "theme", "Aviation theme mentioned", `Found: ${aviation.slice(0, 5).join(", ")}.`);
+  }
+
+  /* ================== Originality ================== */
+  const vendoredFiles = live.filter((f) => VENDORED.test(f.path) && CODE.has(ext(f.path)));
+  const allCode = live.filter((f) => CODE.has(ext(f.path)));
+  if (allCode.length >= 10 && vendoredFiles.length / allCode.length > 0.7) {
+    add("Originality", "warn", "mostly-vendored", "Most code is third-party", `${vendoredFiles.length} of ${allCode.length} source files are in library or vendor folders.`);
+  }
+  if (s.isFork && s.commitCount > 0 && s.commitCount <= 3) {
+    add("Originality", "warn", "fork-untouched", "Fork with almost no changes", `Only ${s.commitCount} commit${s.commitCount === 1 ? "" : "s"} in a fork of ${s.parentFullName ?? "another repo"}.`);
+  }
+
+  const stats: Stats = {
+    files: files.length,
+    sourceFiles: code.length,
+    sourceBytes,
+    commits: s.commitCount,
+    spanDays,
+    activeDays,
+    pcbFiles: pcbs.length,
+    schematicFiles: schematics.length,
+    gerberFiles: gerbers.length,
+    bomFiles: boms.length,
+    cadFiles: cad.length,
+    images: images.length,
+  };
+
+  const { score, verdict } = grade(findings);
+  return { kind, verdict, score, findings, stats };
+}
+
+function countReadmeImages(readme: string | null) {
+  if (!readme) return 0;
+  return (
+    (readme.match(/!\[[^\]]*\]\([^)]+\)/g)?.length ?? 0) +
+    (readme.match(/<img\s/gi)?.length ?? 0)
+  );
+}
+
+/** 100 minus 18 per fail and 7 per warning. Fails also cap the verdict. */
+export function grade(findings: Finding[]): { score: number; verdict: Verdict } {
+  const fails = findings.filter((f) => f.level === "fail").length;
+  const warns = findings.filter((f) => f.level === "warn").length;
+  const score = Math.max(0, 100 - fails * 18 - warns * 7);
+  let verdict: Verdict = "review";
+  if (score >= 80 && fails === 0) verdict = "solid";
+  else if (score < 55 || fails >= 3) verdict = "problems";
+  return { score, verdict };
+}
diff --git a/lib/checker/service.ts b/lib/checker/service.ts
new file mode 100644
index 0000000..f89c123
--- /dev/null
+++ b/lib/checker/service.ts
@@ -0,0 +1,133 @@
+import { redis } from "../redis";
+import { aiConfigured, reviewWithAi } from "./ai";
+import { CheckError, getSnapshot, parseRepoUrl } from "./github";
+import { evaluate, grade } from "./rules";
+import type { CheckResult, Finding } from "./types";
+
+export type CheckInput = {
+  repoUrl: string;
+  projectId?: string;
+  description?: string;
+  hoursClaimed?: number;
+  withAi?: boolean;
+};
+
+const REPO_KEY = "takeoff:chk:repo"; // hash: repo full name -> project id
+const ROOT_KEY = "takeoff:chk:root"; // hash: first commit sha -> repo full name
+const RESULT_PREFIX = "takeoff:chk:result:";
+const RESULT_TTL = 60 * 60 * 24 * 14;
+
+/** The AI step is skipped for clear failures, since rules already say enough. */
+const AI_MIN_SCORE = 40;
+
+export async function runCheck(input: CheckInput): Promise<CheckResult> {
+  const parsed = parseRepoUrl(input.repoUrl);
+  if (!parsed) {
+    throw new CheckError("bad_url", "That doesn't look like a GitHub repo URL. Use https://github.com/owner/repo.");
+  }
+
+  const snap = await getSnapshot(parsed.owner, parsed.repo);
+  const ev = evaluate(snap, {
+    description: input.description,
+    hoursClaimed: input.hoursClaimed,
+  });
+
+  // Cross-submission checks. These need Redis; without it they are skipped.
+  const extra: Finding[] = [];
+  const fullKey = snap.fullName.toLowerCase();
+  const rootSha = snap.firstCommit?.sha;
+  try {
+    if (input.projectId) {
+      const prev = await redis<string | null>("HGET", REPO_KEY, fullKey);
+      if (prev && prev !== input.projectId) {
+        extra.push({
+          id: "dup-repo",
+          group: "Originality",
+          level: "fail",
+          title: "Same repo was submitted by another project",
+          detail: `This repo was already checked for project ${prev}.`,
+        });
+      }
+    }
+    if (rootSha && snap.commitCount > 1) {
+      const other = await redis<string | null>("HGET", ROOT_KEY, rootSha);
+      if (other && other.toLowerCase() !== fullKey) {
+        extra.push({
+          id: "dup-root",
+          group: "Originality",
+          level: "warn",
+          title: "Shares its history with another repo",
+          detail: `The first commit is identical to one in ${other}. One is a fork or a copy of the other.`,
+        });
+      }
+    }
+    // Only real submissions are remembered, so trying out a URL doesn't pollute the data.
+    if (input.projectId) {
+      await redis("HSET", REPO_KEY, fullKey, input.projectId);
+      if (rootSha && snap.commitCount > 1) await redis("HSET", ROOT_KEY, rootSha, snap.fullName);
+    }
+  } catch {
+    // Redis not configured or down.
+  }
+
+  const findings = [...ev.findings, ...extra];
+  const { score, verdict } = grade(findings);
+
+  const result: CheckResult = {
+    ...ev,
+    findings,
+    score,
+    verdict,
+    repoUrl: input.repoUrl,
+    fullName: snap.fullName,
+    htmlUrl: snap.htmlUrl,
+    checkedAt: new Date().toISOString(),
+    projectId: input.projectId,
+  };
+
+  if (input.withAi) {
+    if (!aiConfigured()) {
+      result.aiSkipped = "AI is off: set HACKCLUB_AI_KEY to turn it on.";
+    } else if (score < AI_MIN_SCORE) {
+      result.aiSkipped = "Skipped, the rules already found serious problems.";
+    } else {
+      try {
+        result.ai = await reviewWithAi(snap, result, input.description ?? snap.description ?? "");
+      } catch (e) {
+        result.aiSkipped = `AI step failed: ${e instanceof Error ? e.message : "unknown error"}`;
+      }
+    }
+  }
+
+  if (input.projectId) {
+    try {
+      await redis("SET", RESULT_PREFIX + input.projectId, JSON.stringify(result), "EX", RESULT_TTL);
+    } catch {
+      // Not being able to cache is fine.
+    }
+  }
+
+  return result;
+}
+
+export async function loadLastCheck(projectId: string): Promise<CheckResult | null> {
+  try {
+    const raw = await redis<string | null>("GET", RESULT_PREFIX + projectId);
+    return raw ? (JSON.parse(raw) as CheckResult) : null;
+  } catch {
+    return null;
+  }
+}
+
+/** Simple per-user limit so one reviewer can't burn the GitHub or AI quota. */
+export async function underRateLimit(userId: string, max = 30): Promise<boolean> {
+  try {
+    const bucket = Math.floor(Date.now() / 3_600_000);
+    const key = `takeoff:chk:rl:${userId}:${bucket}`;
+    const n = await redis<number>("INCR", key);
+    if (n === 1) await redis("EXPIRE", key, 3600);
+    return n <= max;
+  } catch {
+    return true;
+  }
+}
diff --git a/lib/checker/types.ts b/lib/checker/types.ts
new file mode 100644
index 0000000..ba51f67
--- /dev/null
+++ b/lib/checker/types.ts
@@ -0,0 +1,106 @@
+export type Level = "pass" | "warn" | "fail" | "info";
+
+export type Group =
+  | "Repository"
+  | "History"
+  | "Hardware"
+  | "Software"
+  | "Docs"
+  | "Originality";
+
+export type Finding = {
+  id: string;
+  group: Group;
+  level: Level;
+  title: string;
+  detail: string;
+};
+
+export type TreeEntry = { path: string; size: number };
+
+export type CommitInfo = {
+  sha: string;
+  date: string; // ISO 8601
+  message: string;
+  author?: string;
+};
+
+/** Everything the rules need, collected from GitHub. Pure data, no network. */
+export type Snapshot = {
+  owner: string;
+  repo: string;
+  fullName: string;
+  htmlUrl: string;
+  description: string | null;
+  topics: string[];
+  defaultBranch: string;
+  isFork: boolean;
+  parentFullName: string | null;
+  archived: boolean;
+  createdAt: string;
+  pushedAt: string;
+  license: string | null;
+  tree: TreeEntry[];
+  treeTruncated: boolean;
+  commitCount: number;
+  /** Newest first, up to 100. */
+  recentCommits: CommitInfo[];
+  firstCommit: (CommitInfo & { filesChanged: number | null }) | null;
+  contributors: { login: string; contributions: number }[];
+  readme: string | null;
+  /** Contents of a few sampled hardware files, keyed by path. */
+  fileText: Record<string, string>;
+};
+
+/** Facts from the submission itself (not from GitHub). */
+export type Context = {
+  description?: string;
+  hoursClaimed?: number;
+};
+
+export type Kind = "hardware" | "software" | "both" | "unclear";
+export type Verdict = "solid" | "review" | "problems";
+
+export type Stats = {
+  files: number;
+  sourceFiles: number;
+  sourceBytes: number;
+  commits: number;
+  spanDays: number | null;
+  activeDays: number | null;
+  pcbFiles: number;
+  schematicFiles: number;
+  gerberFiles: number;
+  bomFiles: number;
+  cadFiles: number;
+  images: number;
+};
+
+export type Evaluation = {
+  kind: Kind;
+  verdict: Verdict;
+  score: number;
+  findings: Finding[];
+  stats: Stats;
+};
+
+export type AiReview = {
+  matchesDescription: "yes" | "partly" | "no" | "unclear";
+  aviationTheme: "yes" | "weak" | "no";
+  hardwareEvidence: "strong" | "some" | "none" | "n/a";
+  summary: string;
+  concerns: string[];
+  model: string;
+};
+
+export type CheckResult = Evaluation & {
+  repoUrl: string;
+  fullName: string;
+  htmlUrl: string;
+  checkedAt: string;
+  projectId?: string;
+  /** Present when the AI step ran. */
+  ai?: AiReview;
+  /** Why the AI step did not run (shown to the reviewer). */
+  aiSkipped?: string;
+};
diff --git a/scripts/test-checker.ts b/scripts/test-checker.ts
new file mode 100644
index 0000000..d28ced2
--- /dev/null
+++ b/scripts/test-checker.ts
@@ -0,0 +1,211 @@
+// Run with: npx tsx scripts/test-checker.ts
+// Offline tests for the repo checker rules. No network or API keys needed.
+import assert from "node:assert/strict";
+import { parseAi } from "../lib/checker/ai";
+import { parseRepoUrl } from "../lib/checker/github";
+import { analyzePcb, analyzeSchematic, bomRows, evaluate, pickSamples } from "../lib/checker/rules";
+import type { Snapshot } from "../lib/checker/types";
+
+const day = (n: number) => new Date(Date.UTC(2026, 9, 1 + n, 12)).toISOString();
+
+const blank: Snapshot = {
+  owner: "kid", repo: "thing", fullName: "kid/thing", htmlUrl: "https://github.com/kid/thing",
+  description: null, topics: [], defaultBranch: "main", isFork: false, parentFullName: null,
+  archived: false, createdAt: day(0), pushedAt: day(0), license: null,
+  tree: [], treeTruncated: false, commitCount: 0, recentCommits: [], firstCommit: null,
+  contributors: [], readme: null, fileText: {},
+};
+
+const ids = (s: Snapshot, ctx = {}) => evaluate(s, ctx).findings.map((f) => `${f.level}:${f.id}`);
+let passed = 0;
+const test = (name: string, fn: () => void) => {
+  fn();
+  passed++;
+  console.log("ok  ", name);
+};
+
+/* ---- URL parsing ---- */
+test("parseRepoUrl accepts normal github urls", () => {
+  assert.deepEqual(parseRepoUrl("https://github.com/a/b"), { owner: "a", repo: "b" });
+  assert.deepEqual(parseRepoUrl("https://github.com/a/b.git"), { owner: "a", repo: "b" });
+  assert.deepEqual(parseRepoUrl("https://github.com/a/b/tree/main/pcb"), { owner: "a", repo: "b" });
+});
+test("parseRepoUrl rejects other hosts and junk", () => {
+  assert.equal(parseRepoUrl("https://evil.com/a/b"), null);
+  assert.equal(parseRepoUrl("http://github.com/a/b"), null);
+  assert.equal(parseRepoUrl("https://github.com/a"), null);
+  assert.equal(parseRepoUrl("https://github.com/a/b%2F..%2Fc"), null);
+  assert.equal(parseRepoUrl("not a url"), null);
+});
+
+/* ---- content analysis ---- */
+test("analyzePcb counts footprints, tracks and outline", () => {
+  const a = analyzePcb('(footprint "R" ) (footprint "C" ) (segment (a)) (segment (b)) (via (at 1 1)) (layer "Edge.Cuts") (layer "Edge.Cuts")');
+  assert.equal(a.footprints, 2);
+  assert.equal(a.tracks, 2);
+  assert.equal(a.vias, 1);
+  assert.equal(a.outline, true);
+});
+test("analyzeSchematic ignores power symbols", () => {
+  const a = analyzeSchematic('(symbol (lib_id "Device:R") ) (symbol (lib_id "power:GND") ) (wire (pts))');
+  assert.equal(a.components, 1);
+  assert.equal(a.wires, 1);
+});
+test("bomRows ignores header and blank lines", () => {
+  assert.equal(bomRows("Ref,Value\nR1,10k\n\nR2,1k\n"), 2);
+});
+test("pickSamples prefers shallow files and skips huge ones", () => {
+  const picked = pickSamples([
+    { path: "a/b/c/deep.kicad_pcb", size: 1000 },
+    { path: "board.kicad_pcb", size: 1000 },
+    { path: "huge.kicad_pcb", size: 9_000_000 },
+    { path: "bom.csv", size: 500 },
+  ]);
+  assert.deepEqual(picked, ["board.kicad_pcb", "a/b/c/deep.kicad_pcb", "bom.csv"]);
+});
+
+/* ---- scenarios ---- */
+const emptyHardware: Snapshot = {
+  ...blank,
+  description: "A custom flight controller PCB for my RC plane",
+  tree: [
+    { path: "board.kicad_pcb", size: 5000 },
+    { path: "main.ino", size: 800 },
+    { path: "notes.txt", size: 10 },
+  ],
+  commitCount: 1,
+  recentCommits: [{ sha: "a", date: day(1), message: "Add files via upload" }],
+  firstCommit: { sha: "a", date: day(1), message: "Add files via upload", filesChanged: 40 },
+  fileText: { "board.kicad_pcb": "(kicad_pcb (version 2))" },
+};
+
+test("empty hardware repo gets flagged hard", () => {
+  const e = evaluate(emptyHardware, { hoursClaimed: 30 });
+  const got = ids(emptyHardware, { hoursClaimed: 30 });
+  assert.ok(got.includes("fail:one-commit"));
+  assert.ok(got.includes("fail:no-readme"));
+  assert.ok(got.includes("fail:pcb-empty:board.kicad_pcb"));
+  assert.ok(got.includes("warn:no-bom"));
+  assert.ok(got.includes("warn:no-photos"));
+  assert.equal(e.verdict, "problems");
+  assert.equal(e.kind, "both");
+});
+
+const goodReadme =
+  "# Skyline flight controller\n\nA small flight controller for fixed-wing RC planes with an IMU and barometer. ".repeat(8) +
+  "\n## Build\nParts are listed in the BOM. Wiring and pinout are in the schematic. Assembly takes an evening, then flash the firmware.\n" +
+  "![assembled board](docs/photo.jpg)\n";
+const goodDays = Array.from({ length: 12 }, (_, i) => day(i * 2));
+const goodHardware: Snapshot = {
+  ...blank,
+  description: "Flight controller for RC planes",
+  topics: ["drone", "kicad"],
+  createdAt: day(0),
+  tree: [
+    { path: "hardware/fc.kicad_pcb", size: 90_000 },
+    { path: "hardware/fc.kicad_sch", size: 60_000 },
+    { path: "hardware/fc.kicad_pro", size: 3_000 },
+    { path: "hardware/bom.csv", size: 900 },
+    { path: "hardware/gerbers/fc-F_Cu.gbr", size: 4_000 },
+    { path: "cad/case.f3d", size: 200_000 },
+    { path: "cad/case.step", size: 300_000 },
+    { path: "firmware/platformio.ini", size: 200 },
+    { path: "firmware/src/main.cpp", size: 9_000 },
+    { path: "firmware/src/imu.cpp", size: 4_000 },
+    { path: "docs/photo.jpg", size: 500_000 },
+    { path: "README.md", size: 1_200 },
+  ],
+  commitCount: 40,
+  recentCommits: goodDays.map((d, i) => ({ sha: `c${i}`, date: d, message: `work ${i}` })).reverse(),
+  firstCommit: { sha: "c0", date: day(0), message: "start", filesChanged: 3 },
+  contributors: [{ login: "kid", contributions: 40 }],
+  readme: goodReadme,
+  fileText: {
+    "hardware/fc.kicad_pcb": '(footprint "a") (footprint "b") (segment x) (segment y) (layer "Edge.Cuts") (layer "Edge.Cuts")',
+    "hardware/fc.kicad_sch": '(symbol (lib_id "Device:R")) (wire (pts))',
+    "hardware/bom.csv": "Ref,Value\nR1,10k\nR2,1k\nC1,1u\nU1,MCU\n",
+  },
+};
+
+test("a solid hardware repo passes cleanly", () => {
+  const e = evaluate(goodHardware, { hoursClaimed: 20 });
+  const bad = e.findings.filter((f) => f.level === "fail" || f.level === "warn");
+  assert.deepEqual(bad.map((f) => f.id), []);
+  assert.equal(e.verdict, "solid");
+  assert.equal(e.kind, "both");
+  assert.ok(e.score >= 95);
+});
+
+test("claimed hours that exceed the commit timeline are warned", () => {
+  const quick: Snapshot = {
+    ...goodHardware,
+    recentCommits: [
+      { sha: "x2", date: "2026-10-01T15:00:00Z", message: "b" },
+      { sha: "x1", date: "2026-10-01T12:00:00Z", message: "a" },
+    ],
+    firstCommit: { sha: "x1", date: "2026-10-01T12:00:00Z", message: "a", filesChanged: 3 },
+    commitCount: 2,
+  };
+  assert.ok(ids(quick, { hoursClaimed: 40 }).includes("warn:hours-vs-span"));
+  assert.ok(!ids(quick, { hoursClaimed: 2 }).includes("warn:hours-vs-span"));
+});
+
+test("template software repo is flagged", () => {
+  const web: Snapshot = {
+    ...blank,
+    isFork: true,
+    parentFullName: "someone/takeoff",
+    tree: [
+      { path: "app/page.tsx", size: 900 },
